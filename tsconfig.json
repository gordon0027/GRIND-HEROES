{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Self-contained on purpose: this template is copied out of the monorepo (as the seed for an AI
  // Coder project) and must typecheck on its own, so it does not `extends` tsconfig.base.json. Keep
  // the shared options below in sync with tsconfig.base.json.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "noEmit": true,
    "jsx": "react-jsx",

    // Inside the monorepo these point typecheck at the SDK/host source, so no SDK build is needed.
    // Outside it the paths do not exist and TypeScript falls back to node_modules resolution.
    "paths": {
      "@idosgames/core": ["../../packages/core/src/index.ts"],
      "@idosgames/core/realtime": ["../../packages/core/src/realtime/index.ts"],
      "@idosgames/module-sdk": ["../../packages/module-sdk/src/index.ts"],
      "@idosgames/react/ui": ["../../packages/react/src/ui/index.ts"],
      "@idosgames/react": ["../../packages/react/src/index.ts"],
      "@idosgames/app-shell": ["../../packages/app-shell/src/index.ts"]
    }
  },
  "include": ["src"],
  // Tests are not part of the game: the platform builds with no test runner installed, so a
  // `*.test.ts` that imports vitest would fail every release build. Keep them out of the typecheck.
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx"
  ]
}
